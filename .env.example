# Focus Tracker Environment Variables

# Database
DATABASE_PATH=/Users/mich/PycharmProjects/focus-track/focus.db

# API Server
PORT=5001

# LLM Provider (gemini or ollama)
FOCUS_PROVIDER=gemini

# Gemini API Key (get from https://ai.google.dev)
GEMINI_API_KEY=

# Ollama (if using local inference)
OLLAMA_HOST=http://localhost:11434

# Screenshot Settings
FOCUS_TRACK_ROOT=/Users/mich/PycharmProjects/focus-track
FOCUS_TRACK_IDLE_SEC=60
FOCUS_TRACK_TICK_MIN_SEC=120
FOCUS_TRACK_TICK_MAX_SEC=600

# Telegram Notifications (optional, for critical error alerts)
TG_BOT_TOKEN=
TG_CHAT_ID=
